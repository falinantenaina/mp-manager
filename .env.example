# Base de données PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fb_mp_manager"

# NextAuth — générez un secret fort : openssl rand -base64 32
NEXTAUTH_SECRET="CHANGEZ_MOI_32_CHARS_MINIMUM"
NEXTAUTH_URL="https://votre-domaine.com"

# Cloudinary (upload images produits)
CLOUDINARY_CLOUD_NAME="votre_cloud_name"
CLOUDINARY_API_KEY="votre_api_key"
CLOUDINARY_API_SECRET="votre_api_secret"

# VAPID pour les push notifications
# Génération : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="VOTRE_CLE_PUBLIQUE_VAPID"
VAPID_PRIVATE_KEY="VOTRE_CLE_PRIVEE_VAPID"
VAPID_EMAIL="contact@votredomaine.com"
